generator client {
  provider = "prisma-client-js"
}

// SQLite for the laptop demo. For a hosted link: provider = "postgresql" + Neon URL, then a fresh migration.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id       Int       @id @default(autoincrement())
  name     String
  email    String    @unique
  role     String // STUDENT | STAFF | ADMIN
  bookings Booking[]
}

model Equipment {
  id                 Int       @id @default(autoincrement())
  name               String
  type               String
  location           String
  notes              String?
  outOfService       Boolean   @default(false)
  outOfServiceReason String?
  bookings           Booking[]
}

// One record covers both ideas: a reservation (start/end) that becomes a checkout when collected.
// Free / booked / in use / overdue are derived from these fields, never stored.
model Booking {
  id           Int       @id @default(autoincrement())
  equipment    Equipment @relation(fields: [equipmentId], references: [id])
  equipmentId  Int
  user         User      @relation(fields: [userId], references: [id])
  userId       Int
  start        DateTime
  end          DateTime
  checkedOutAt DateTime?
  checkedInAt  DateTime?
  cancelledAt  DateTime?

  @@index([equipmentId, start])
}
