generator client {
  provider = "prisma-client-js"
}

// SQLite for the laptop demo. For a hosted link: provider = "postgresql" + Neon URL, then a fresh migration.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  role          String // STUDENT | STAFF | ADMIN
  studentId     String? // university ID: every booking is tied to it (client, 16 Oct)
  category      String? // Undergraduate | Postgraduate | PhD | Academic staff | Technical staff
  bookings      Booking[]      @relation("booker")
  reviewed      Booking[]      @relation("reviewer")
  faults        Fault[]        @relation("reporter")
  resolved      Fault[]        @relation("resolver")
  watches       Watch[]
  notifications Notification[]
}

model Equipment {
  id                 Int       @id @default(autoincrement())
  name               String
  type               String
  location           String
  assetId            String? // from the lab's inventory sheet, e.g. ROB-001 (shared by identical units)
  manufacturer       String?
  model              String?
  serialNumber       String?
  condition          String? // latest known condition: inventory sheet, then each return
  notes              String?
  safetyInfo         String? // shown before anyone books (client: "particularly important")
  manualUrl          String?
  photoUrl           String?
  outOfService       Boolean   @default(false)
  outOfServiceReason String?
  bookings           Booking[]
  faults             Fault[]
  watches            Watch[]
}

// One record covers both ideas: a reservation (start/end) that becomes a checkout when collected.
// Free / booked / in use / overdue are derived from these fields, never stored.
model Booking {
  id           Int       @id @default(autoincrement())
  equipment    Equipment @relation(fields: [equipmentId], references: [id])
  equipmentId  Int
  user         User      @relation("booker", fields: [userId], references: [id])
  userId       Int
  start        DateTime
  end          DateTime
  purpose      String?
  useLocation  String? // null = inside the robotics lab; otherwise where it is taken (needs approval)
  kind         String    @default("STANDARD") // STANDARD | EXTENDED (longer or multi-day, needs approval)
  justification String? // why an extended booking is needed
  approval     String    @default("APPROVED") // APPROVED | PENDING | REJECTED
  reviewer     User?     @relation("reviewer", fields: [reviewedById], references: [id])
  reviewedById Int?
  reviewedAt   DateTime?
  reviewNote   String?
  checkedOutAt DateTime?
  checkedInAt  DateTime?
  cancelledAt  DateTime?
  // Condition at hand-over and return (client: flat batteries delayed the next user by hours)
  conditionOut String?
  batteryOut   String?
  conditionIn  String?
  batteryIn    String?
  returnNote   String?
  faults       Fault[]

  @@index([equipmentId, start])
  @@index([userId, start])
}

model Fault {
  id           Int       @id @default(autoincrement())
  equipment    Equipment @relation(fields: [equipmentId], references: [id])
  equipmentId  Int
  reporter     User      @relation("reporter", fields: [reporterId], references: [id])
  reporterId   Int
  booking      Booking?  @relation(fields: [bookingId], references: [id])
  bookingId    Int?
  description  String
  severity     String // MINOR | UNUSABLE (UNUSABLE takes the item out of service)
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolver     User?     @relation("resolver", fields: [resolvedById], references: [id])
  resolvedById Int?
  resolution   String?
}

// "Tell me when it's free" (client: email people who wanted a booked robot when it is available again)
model Watch {
  id          Int       @id @default(autoincrement())
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  equipmentId Int
  user        User      @relation(fields: [userId], references: [id])
  userId      Int
  createdAt   DateTime  @default(now())

  @@unique([equipmentId, userId])
}

// Every reminder and alert the system would email. The prototype shows them in each person's inbox;
// connecting a university mail server means implementing deliver() in src/lib/notify.ts.
model Notification {
  id        Int       @id @default(autoincrement())
  user      User      @relation(fields: [userId], references: [id])
  userId    Int
  kind      String
  subject   String
  body      String
  link      String?
  key       String    @unique // stops the same reminder being sent twice
  createdAt DateTime  @default(now())
  readAt    DateTime?
}
